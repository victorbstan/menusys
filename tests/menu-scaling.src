// Issue 6: assertions run against real menu widgets and engine screenshots.
#define m_init scaling_original_init
#define m_draw scaling_original_draw
#define m_consolecommand scaling_original_command
#include "../menu.src"
#undef m_init
#undef m_draw
#undef m_consolecommand
void() scaling_checknative =
{
    if (!cvar("scaling_test_nativezoom")) return;
    vector pixels = (vector)getproperty(VF_SCREENPSIZE);
    float expected = max(1, min(pixels.x/640, pixels.y/400));
    float actualconsole = cvar(engine == E_QSS ? "scr_conscale" : "con_textsize");
    float actualhud = cvar(engine == E_QSS ? "scr_sbarscale" : "vid_conautoscale");
    if (fabs(actualconsole - (engine == E_QSS ? expected : -8*expected)) > 0.01 || fabs(actualhud - expected) > 0.01)
        print("SCALE FAIL native automatic zoom after resize\n");
};
mitem_frame(mitem_frame parent) layout_findframe =
{
	for (mitem child = parent.item_children; child; child = child.item_next)
	{
		if (!(child.item_flags & IF_ISFRAME)) continue;
		mitem_frame frame = (mitem_frame)child;
		if (frame.frame_hasscroll) return frame;
		frame = layout_findframe(frame);
		if (frame) return frame;
	}
	return __NULL__;
};
var float scaling_iconcalls;
float(vector pos, string pic, vector size, vector rgb, float alpha, float flags) scaling_iconpic =
{
    vector native = drawgetimagesize(pic);
    vector expected = native * min(16/native.x, 16/native.y);
    vector expectedpos = '37 51 0' + ('16 16 0'-expected)*0.5;
    if (vlen(size-expected) > 0.01 || vlen(pos-expectedpos) > 0.01)
        print("SCALE FAIL mod icon aspect/centering\n");
    scaling_iconcalls += 1;
    return 0;
};
void() scaling_checkicons =
{
    float(vector pos, string pic, vector size, vector rgb, float alpha, float flags) savedpic = ui.drawpic;
    ui.drawpic = scaling_iconpic;
    scaling_iconcalls = 0;
    for (float i = 0; i < 2; i++)
    {
        mitem_pictext icon = spawn(mitem_pictext, pic:i ? "gfx/qplaque.lmp" : "gfx/p_multi.lmp", item_size:'100 16', item_text:"", item_scale:8);
        icon.item_draw('37 51 0');
        icon.item_remove();
    }
    ui.drawpic = savedpic;
    if (scaling_iconcalls != 2) print("SCALE FAIL mod icons bypass menu projection\n");
};
var string scaling_screen;
var float scaling_checked;
var float scaling_titles;
var float scaling_iconchecked;
var float scaling_live = 0;
var float scaling_request = 0;
var float scaling_polltime = 0;
var float scaling_capturetime = 0;
var float scaling_clock = 0;
var float autocvar_scaling_test_live = 0;
mitem(mitem_frame frame, string command) scaling_findcontrol =
{
    for (mitem child = frame.item_children; child; child = child.item_next)
    {
        if (child.item_command == command) return child;
        if (child.item_flags & IF_ISFRAME)
        {
            mitem found = scaling_findcontrol((mitem_frame)child, command);
            if (found) return found;
        }
    }
    return __NULL__;
};
void() scaling_checkhudalpha =
{
    string key = engine == E_FTE ? "cl_sbaralpha" : "scr_sbaralpha";
    mitem control = scaling_findcontrol((mitem_frame)desktop.item_kactivechild, key);
    if (!control || !(control.item_flags & IF_SELECTABLE))
    {
        print("SCALE FAIL HUD Alpha control missing/disabled\n");
        return;
    }
    float oldalpha = cvar(key), oldmode = cvar("cl_sbar");
    float oldview = cvar("viewsize"), oldmenu = cvar("menu_zoom");
    float oldhud = cvar(engine == E_FTE ? "vid_conautoscale" : "scr_sbarscale");
    float oldconsole = cvar(engine == E_FTE ? "con_textsize" : "scr_conscale");
    cvar_set(key, "0.5");
    control.item_keypress('0 0', K_RIGHTARROW, 0, TRUE);
    if (fabs(cvar(key)-0.55) > 0.001)
        print("SCALE FAIL HUD Alpha keyboard/native binding\n");
    if (engine == E_FTE && cvar("cl_sbar") != 2)
        print("SCALE FAIL FTE translucent HUD mode\n");
    cvar_set(key, "0");
    control.item_keypress('0 0', K_LEFTARROW, 0, TRUE);
    if (cvar(key) != 0) print("SCALE FAIL HUD Alpha lower bound\n");
    cvar_set(key, "1");
    control.item_keypress('0 0', K_RIGHTARROW, 0, TRUE);
    if (cvar(key) != 1) print("SCALE FAIL HUD Alpha upper bound\n");
    if (cvar("viewsize") != oldview || cvar("menu_zoom") != oldmenu ||
        cvar(engine == E_FTE ? "vid_conautoscale" : "scr_sbarscale") != oldhud ||
        cvar(engine == E_FTE ? "con_textsize" : "scr_conscale") != oldconsole)
        print("SCALE FAIL HUD Alpha changed unrelated settings\n");
    cvar_set(key, ftos(oldalpha));
    if (engine == E_FTE) cvar_set("cl_sbar", ftos(oldmode));
    print("SCALE HUD Alpha checked\n");
};
void(mitem_frame frame, vector origin) scaling_inspect =
{
    for (mitem child = frame.item_children; child; child = child.item_next)
    {
        vector absolute = origin + child.item_position;
        if (child.item_size.x < 0 || child.item_size.y < 0)
            print("SCALE FAIL negative size ", child.item_text, "\n");
        if ((!strncmp(child.item_text, "gfx/", 4) || !strncmp(child.item_text, "menugfx/", 8)) && substring(child.item_text, -4, 4) == ".lmp")
        {
            vector native = drawgetimagesize(child.item_text);
            float file = fopen(child.item_text, FILE_READ);
            if (file < 0 || native.x <= 0 || native.y <= 0)
                print("SCALE FAIL missing image ", child.item_text, "\n");
            if (file >= 0) fclose(file);
            if (native.y > 0 && child.item_size.y > 0 && fabs(child.item_size.x/child.item_size.y - native.x/native.y) > 0.01)
                print("SCALE FAIL image aspect ", scaling_screen, " ", child.item_text, " size ", vtos(child.item_size), "\n");
            if (!strncmp(child.item_text, "gfx/p_", 6) || !strncmp(child.item_text, "gfx/ttl_", 8) || !strncmp(child.item_text, "menugfx/p_", 10))
            {
                scaling_titles += 1;
                if (scaling_screen == "newgame" && child.item_text != "gfx/p_multi.lmp")
                    print("SCALE FAIL multiplayer artwork missing\n");
                if (fabs(absolute.y-(ui.screensize.y/2-MENU_HEIGHT/2+PADDING)) > 0.01)
                    print("SCALE FAIL title vertical origin ", scaling_screen, "\n");
                if (fabs(child.item_size.y-24) > 0.01)
                    print("SCALE FAIL title height ", scaling_screen, " ", child.item_text, "\n");
                if (fabs(child.item_position.x+child.item_size.x/2-frame.item_size.x/2) > 0.01)
                    print("SCALE FAIL title center ", scaling_screen, " ", child.item_text, "\n");
            }
        }
        if (child.item_flags & IF_ISFRAME) scaling_inspect((mitem_frame)child, absolute);
    }
};
float(string input) m_consolecommand =
{
    tokenize(input);
    string command = argv(0), screen = argv(1);
    if (command == "scale_live")
    {
        scaling_live = 1;
        cvar_set("scaling_test_live", "1");
        print("SCALE LIVE ready\n");
        if (engine == E_FTE) localcmd("scale_tick\n");
        return TRUE;
    }
    if (command == "scale_tick")
    {
        // Explicit captures keep a hidden FTE window drawing across its
        // delayed startup VM reload without changing user focus.
        if (cvar("scaling_test_live") && scaling_request >= 0)
            localcmd("screenshot live-tick.png;in 0.05 scale_tick\n");
        return TRUE;
    }
    if (command == "scale_open")
    {
        m_toggle(0);
        if (scaling_screen) strunzone(scaling_screen);
        scaling_screen = strzone(screen);
        scaling_checked = FALSE;
        scaling_iconchecked = FALSE;
        if (screen == "main") M_Main(desktop);
        else if (screen == "single") M_Single(desktop);
        else if (screen == "multi") M_Multi(desktop);
        else if (screen == "options") M_Options(desktop);
        else if (screen == "basic") M_Options_Basic(desktop);
        else if (screen == "video") M_Options_Video(desktop);
        else if (screen == "keys") M_Options_Keys(desktop);
        else if (screen == "audio") M_Options_Audio(desktop);
        else if (screen == "effects") M_Options_Effects(desktop);
        else if (screen == "newgame") M_NewGame(desktop);
        else if (screen == "setup") M_PlayerSetup(desktop);
        else if (screen == "help") M_Help(desktop);
        else if (screen == "levels") M_Levels(desktop);
        else if (screen == "demos") M_Demos(desktop);
        else if (screen == "load") M_Load(desktop);
        else if (screen == "save") M_Save(desktop);
        else if (screen == "particles") M_Options_Particles(desktop);
        else if (screen == "hud") M_Options_Hud(desktop);
        else if (screen == "configs") M_Configs(desktop);
        else if (screen == "presets") M_Preset(desktop);
        else if (screen == "cvars") M_Menu_Cvars(desktop);
        else if (screen == "mods")
        {
            M_Menu_Mods(desktop);
            mitem_frame modlist = layout_findframe((mitem_frame)desktop.item_kactivechild);
            // Real production icon drawing, with wide and tall native assets.
            float iconrow = 0;
            for (mitem row = modlist.item_children; row; row = row.item_next)
                iconrow = max(iconrow, row.item_position.y+row.item_size.y);
            modlist.add(spawn(mitem_pictext, pic:"gfx/p_multi.lmp", item_text:"Wide icon", item_scale:8), 0, [0, iconrow], '200 16');
            modlist.add(spawn(mitem_pictext, pic:"gfx/qplaque.lmp", item_text:"Tall icon", item_scale:8), 0, [0, iconrow+16], '200 16');
        }
        else if (screen == "help1") M_Help1(desktop);
        else if (screen == "help2") M_Help2(desktop);
        else if (screen == "help3") M_Help3(desktop);
        else if (screen == "help4") M_Help4(desktop);
        else if (screen == "help5") M_Help5(desktop);
        else print("SCALE FAIL unknown fixture screen\n");
        ui.mgrabs = ui.kgrabs = __NULL__;
        items_updategrabs(TRUE);
        return TRUE;
    }
    if (command == "scale_check")
    {
        scaling_checknative();
        if (scaling_screen == "video") scaling_checkhudalpha();
        // Physical uniformity is checked independently from screenshot pixels.
        if (!desktop.item_kactivechild) print("SCALE FAIL no active screen\n");
        else
        {
            scaling_titles = 0;
            scaling_inspect((mitem_frame)desktop.item_kactivechild, '0 0 0');
            if (strncmp(scaling_screen, "help", 4) && scaling_titles != 1)
                print("SCALE FAIL missing/duplicate title ", scaling_screen, "\n");

        }
        print("SCALE checked ", scaling_screen, " virtual ", vtos(ui.screensize), " scale ", vtos(menu_drawscale), "\n");
        scaling_checked = TRUE;
        return TRUE;
    }
    if (command == "scale_scroll")
    {
        mitem_frame scroll = layout_findframe((mitem_frame)desktop.item_kactivechild);
        if (scroll && scroll.vslider) scroll.vslider.val = scroll.vslider.maxv;
        return TRUE;
    }
    return scaling_original_command(input);
};
// Independent pixel measurement in the runner detects physical stretching even
// if the engine provides virtual dimensions or independently clamps each axis.
void(vector screensize) m_draw =
{
    scaling_clock += 1;
    scaling_live = cvar("scaling_test_live");
    scaling_original_draw(screensize);
    ui.drawfill('8 8', '32 32', '1 0 1', 1, 0);
    // A native 8x8 glyph enlarged to 32 physical pixels in height. The runner
    // checks flat texel rows and sharp edges, allowing native font aspect bias.
    vector pixels = (vector)getproperty(VF_SCREENPSIZE);
    vector pixelunit = [screensize.x/pixels.x/menu_drawscale.x,
        screensize.y/pixels.y/menu_drawscale.y, 0];
    ui.drawfill([64*pixelunit.x, 8*pixelunit.y, 0],
        [40*pixelunit.x, 40*pixelunit.y, 0], '0 0 0', 1, 0);
    ui.drawstring([64*pixelunit.x, 8*pixelunit.y, 0], "A",
        [32*pixelunit.x, 32*pixelunit.y, 0], '1 1 1', 1, 0);
    if (scaling_screen == "mods" && !scaling_iconchecked)
    {
        scaling_checkicons();
        scaling_iconchecked = TRUE;
    }
    if (scaling_live && scaling_clock >= scaling_polltime)
    {
        scaling_polltime = scaling_clock+6;
        float requestfile = fopen("scale-request.txt", FILE_READ);
        if (requestfile >= 0)
        {
            float request = stof(fgets(requestfile));
            fclose(requestfile);
            if (request != scaling_request)
            {
                scaling_request = request;
                scaling_capturetime = scaling_clock+18;
                if (request == 4)
                {
                    // Supply a pointer at a known physical position, expressed
                    // in the engine's coordinates. Exercise production inverse
                    // projection, hover/focus and key handling independently of
                    // Windows' hidden-window cursor/focus behavior.
                    vector physical = (vector)getproperty(VF_SCREENPSIZE);
                    float scale = cvar("menu_zoom") > 0 ? min(cvar("menu_zoom"), min(physical.x/320, physical.y/200)) : min(physical.x/640, physical.y/400);
                    vector pointer = [(physical.x/2+32*scale)*screensize.x/physical.x,
                        (physical.y/2-50*scale)*screensize.y/physical.y, 0];
                    ui.mousepos = menu_unproject(pointer);
                    desktop.item_draw(desktop.item_position);
                    desktop.item_keypress(desktop.item_position, K_MOUSE1, 0, TRUE);
                    desktop.item_keypress(desktop.item_position, K_MOUSE1, 0, FALSE);
                }
            }
        }
    }
    if (scaling_live && scaling_capturetime && scaling_clock >= scaling_capturetime)
    {
        scaling_capturetime = 0;
        if (scaling_request < 0) localcmd("quit\n");
        else
        {
            if (scaling_request == 4 && desktop.item_kactivechild.item_text != "Singleplayer Menu")
                print("SCALE FAIL mouse click after resize\n");
            print("SCALE LIVE ", ftos(scaling_request), " active ", desktop.item_kactivechild.item_text, "\n");
            localcmd(engine == E_QSS ? "scale_check;screenshot png\n" : sprintf("scale_check;screenshot live%g.png\n", scaling_request));
        }
    }
};
void() m_init =
{
    scaling_original_init();
    registercommand("scale_open");
    registercommand("scale_check");
    registercommand("scale_scroll");
    registercommand("scale_live");
    registercommand("scale_tick");
};
