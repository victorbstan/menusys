// Test-only entry points; never package this module as a release.
#define m_init layout_original_init
#define m_draw layout_original_draw
#define m_consolecommand layout_original_command
#include "../menu.src"
#undef m_init
#undef m_draw
#undef m_consolecommand

mitem_frame layout_frame;
mitem_frame(mitem_frame parent) layout_findframe =
{
	for (mitem child = parent.item_children; child; child = child.item_next)
	{
		if (!(child.item_flags & IF_ISFRAME)) continue;
		mitem_frame frame = (mitem_frame)child;
		if (frame.frame_hasscroll) return frame;
		frame = layout_findframe(frame);
		if (frame) return frame;
	}
	return __NULL__;
};
void(vector pos, float idx) layout_grid_draw =
{
	ui.drawstring(pos, sprintf("Package %02g", idx), '8 8', RGB_TXT, 1, 0);
};
string(string key) layout_info =
{
	if (key == "info")
		return "^aVersion:^a 1.2.3\n^aAuthor:^a Layout fixture\n^aLicense:^a GPL\n^aWebsite:^a https://example.invalid/a/very/long/package/path\n^aDescription:^a Long wrapped package metadata. This description is deliberately tall enough to require scrolling in the details pane.\nFirst extra line\nSecond extra line\nThird extra line\nFourth extra line\nFifth extra line";
	return cvar_string(key);
};
float(string cstr) m_consolecommand =
{
	tokenize(cstr);
	string cmd = argv(0);
	if (cmd == "layout_video" || cmd == "layout_effects")
	{
		m_toggle(0);
		if (cmd == "layout_video") M_Options_Video(desktop);
		else M_Options_Effects(desktop);
		layout_frame = layout_findframe((mitem_frame)desktop.item_kactivechild);
		print("LAYOUT active ", desktop.item_kactivechild.item_text, "\n");
	}
	else if (cmd == "layout_updates")
	{
		m_toggle(0);
		M_Menu_Updates(desktop);
		layout_frame = __NULL__;
	}
	else if (cmd == "layout_metadata")
	{
		menu_updates updates = (menu_updates)desktop.findchildtext("Updates List");
		updates.get = layout_info;
		updates.grid.grid_draw = layout_grid_draw;
		updates.grid.grid_numchildren = 60;
		updates.grid.item_resized();
		updates.grid.grid_kactive = 59;
		updates.grid.vslider.val = updates.grid.vslider.maxv;
	}
	else if (cmd == "layout_details")
	{
		menu_updates details = (menu_updates)desktop.findchildtext("Updates List");
		mitem_frame panel = (mitem_frame)details.grid.item_parent;
		mitem_label label = (mitem_label)panel.findchildtext("info");
		if (label.vslider) label.vslider.val = label.vslider.maxv;
		print("LAYOUT details height ", ftos(label.vslider.maxv), "\n");
	}
	else return layout_original_command(cstr);
	// Clear grabs retained by the previous fixture before forcing a fresh draw.
	ui.kgrabs = ui.mgrabs = __NULL__;
	items_updategrabs(TRUE);
	return TRUE;
};
void(vector screensize) m_draw =
{
	layout_original_draw(screensize);
	if (layout_frame && layout_frame.vslider)
		layout_frame.vslider.val = min(96, layout_frame.vslider.maxv);
};
void() m_init =
{
	layout_original_init();
	registercommand("layout_video");
	registercommand("layout_effects");
	registercommand("layout_updates");
	registercommand("layout_metadata");
	registercommand("layout_details");
};
