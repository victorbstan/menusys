// Test actual checkbox activation and persisted native engine settings.
#define m_init preferences_original_init
#define m_consolecommand preferences_original_command
#include "../menu.src"
#undef m_consolecommand
#undef m_init
mitem(mitem_frame parent, string command) preferences_find =
{
    for (mitem child = parent.item_children; child; child = child.item_next)
    {
        if (child.item_command == command) return child;
        if (child.item_flags & IF_ISFRAME)
        {
            mitem result = preferences_find((mitem_frame)child, command);
            if (result) return result;
        }
    }
    return __NULL__;
};
float(string input) m_consolecommand =
{
    tokenize(input);
    if (argv(0) == "pref_exit") { localcmd("wait;wait;quit\n"); return TRUE; }
    if (argv(0) == "pref_assert")
    {
        mitem initial = preferences_find((mitem_frame)desktop.item_kactivechild, "menu_alwaysmlook");
        if (!initial || initial.get("menu_alwaysmlook") != argv(1)) print("PREF FAIL initial mouselook\n");
        else print("PREF initial mouselook ", argv(1), "\n");
        return TRUE;
    }
    if (argv(0) == "pref_toggle")
    {
        mitem item = preferences_find((mitem_frame)desktop.item_kactivechild, "menu_alwaysmlook");
        if (!item || !(item.item_flags & IF_SELECTABLE)) print("PREF FAIL checkbox missing or disabled\n");
        else
        {
            item.item_keypress('0 0 0', K_ENTER, 0, TRUE);
            print("PREF mouselook ", item.get("menu_alwaysmlook"), "\n");
        }
        return TRUE;
    }
    if (argv(0) == "pref_zoom")
    {
        options_video menu = (options_video)desktop.item_kactivechild;
        menu.set("menu_consolezoom", argv(1));
        print("PREF zoom ", menu.get("menu_consolezoom"), " width ", cvar_string("scr_conwidth"), "\n");
        return TRUE;
    }
    return preferences_original_command(input);
};
void() m_init = { preferences_original_init(); registercommand("pref_toggle"); registercommand("pref_zoom"); registercommand("pref_exit"); registercommand("pref_assert"); };
