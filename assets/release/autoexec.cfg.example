// Optional settings: copy only the lines you want into your own autoexec.cfg.

// FTE only: uncomment ONE cursor choice. Empty selects the system cursor.
// cl_cursor ""

// cl_cursor "menugfx/cursor_copr.tga"
// cl_cursor "menugfx/cursor_tintin.tga"
// cl_cursor_size 2
// cl_cursorbias 0

// QSS: choose Console Zoom and Message Zoom under Options > Video.
// Automatic follows window size; fixed choices are x1, x1.5, x2, and x4.
// Set a fixed choice there before using engine text-scale overrides.
// The replacement menu always scales automatically with the window.

// Optional QSS status bar scale (independent of menu and text zoom).
// scr_sbarscale 4

// Optional classic texture filtering.
// gl_texturemode gl_nearest
